    <color name="w_ink">#FFFFFFFF</color>
    <color name="w_dim">#99FFFFFF</color>
    <color name="w_tint">#FF9F0A</color>
    <color name="w_tint_soft">#33FF9F0A</color>
    <color name="w_good">#30D158</color>
    <color name="w_good_soft">#2E30D158</color>
    <color name="w_track">#26FFFFFF</color>
