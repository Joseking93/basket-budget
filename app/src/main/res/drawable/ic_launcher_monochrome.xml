<?xml version="1.0" encoding="utf-8"?>
<!--
  What the launcher draws when the phone is set to tint every icon to the
  wallpaper. Only the shape survives that, so the gold slice is not in it:
  tinted, the two arcs would be the same colour and the gaps would read as
  damage rather than as a division. One unbroken ring is the same idea with
  nothing that depends on colour to carry it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,28 A26,26 0 1,1 54,80 A26,26 0 1,1 54,28"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10" />
</vector>
