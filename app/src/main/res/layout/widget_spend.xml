<?xml version="1.0" encoding="utf-8"?>
<!-- The one worth a home-screen slot: it answers the question rather than
     offering to open something that will. An alarm widget shows the time;
     a budget widget should show the money. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/spend_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_spend_label"
            android:textAllCaps="true"
            android:textColor="@color/w_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_chip_tint"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_wallet" />
    </LinearLayout>

    <TextView
        android:id="@+id/spend_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/widget_spend_empty"
        android:textColor="@color/w_ink"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/spend_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/spend_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_spend_note"
        android:textColor="@color/w_dim"
        android:textSize="12sp" />
</LinearLayout>
