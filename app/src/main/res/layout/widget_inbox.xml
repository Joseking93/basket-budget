<?xml version="1.0" encoding="utf-8"?>
<!-- Two lines: what it does, and what it last found. The second is the point —
     a button that only ever says "read messages" cannot tell you whether the
     tracker is current, which is the actual question. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_chip_good"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_inbox" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_inbox_label"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_inbox_idle"
            android:textColor="@color/w_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
